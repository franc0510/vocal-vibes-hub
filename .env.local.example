# Supabase Configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_PUBLIC_KEY

# Notes:
# 1. Get VITE_SUPABASE_URL from: Supabase Dashboard → Settings → API → Project URL
# 2. Get VITE_SUPABASE_PUBLISHABLE_KEY from: Supabase Dashboard → Settings → API → anon (public)
# 3. NEVER commit this file or expose secret keys in frontend
# 4. This file is in .gitignore already

# Application URL — used to build shareable invite links.
# Without it, links built inside the iOS app would carry `capacitor://localhost`
# and be dead for everyone who receives them.
VITE_APP_URL=https://vocme-tawny.vercel.app

# App Store listing, shown as a fallback on the invite page when the app is not
# installed. Leave empty to hide the button rather than link to a dead page.
VITE_APP_STORE_URL=
