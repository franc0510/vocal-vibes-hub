# Supabase Configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_PUBLIC_KEY

# Notes:
# 1. Get VITE_SUPABASE_URL from: Supabase Dashboard → Settings → API → Project URL
# 2. Get VITE_SUPABASE_PUBLISHABLE_KEY from: Supabase Dashboard → Settings → API → anon (public)
# 3. NEVER commit this file or expose secret keys in frontend
# 4. This file is in .gitignore already

# Application URL — used to build shareable invite links.
# Without it, links built inside the iOS app would carry `capacitor://localhost`
# and be dead for everyone who receives them.
VITE_APP_URL=https://vocme-tawny.vercel.app

# App Store listing. When someone opens an invite link without the app, the
# invite screen tries `vocme://` and, if nothing opens, sends them here.
# Accepts the full URL or just the numeric App ID (e.g. 6478123456).
# Leave empty to say "keep going in your browser" rather than link to a dead page.
VITE_APP_STORE_URL=

# Play Store listing. Empty while VocMe is iOS-only: the URL could be built
# from the package id (com.vocme.app), but it would land on an error page.
VITE_PLAY_STORE_URL=
